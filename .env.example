# Base de données Turso — utilisée UNIQUEMENT en production et pour les migrations
# distantes explicites (`db:migrate:remote`). Le serveur de dev local (`astro dev`)
# et les commandes Drizzle/seed par défaut ignorent totalement ces valeurs et
# utilisent toujours une base SQLite locale isolée (`file:local.db`).
TURSO_DATABASE_URL=libsql://votre-db.turso.io
TURSO_AUTH_TOKEN=votre-token

# Secret admin (page /admin) — générez une valeur forte et unique.
# Ne réutilisez jamais cet exemple, et ne partagez jamais la vraie valeur.
ADMIN_SECRET=

# Secret de signature des sessions (HMAC-SHA256) — requis en production, servez-vous par
# exemple de `openssl rand -hex 32` pour en générer un. Sans lui, le serveur refuse de créer ou
# de vérifier des sessions en dehors d'un environnement de développement.
SESSION_SECRET=
