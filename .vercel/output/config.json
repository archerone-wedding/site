{
	"version": 3,
	"routes": [
		{
			"src": "^/_astro(?:/(.*))$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/_actions(?:/(.*?))?/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/?$",
			"dest": "_render"
		},
		{
			"src": "^/contact/?$",
			"dest": "_render"
		},
		{
			"src": "^/gate/?$",
			"dest": "_render"
		},
		{
			"src": "^/itineraire/?$",
			"dest": "_render"
		},
		{
			"src": "^/le-mariage/?$",
			"dest": "_render"
		},
		{
			"src": "^/legad/?$",
			"dest": "_render"
		},
		{
			"src": "^/logement/?$",
			"dest": "_render"
		},
		{
			"src": "^/rsvp/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render"
		}
	]
}