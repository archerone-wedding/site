<div class="program-content">
  <div class="programme">

    <!-- Corde centrale motif -->
    <div class="rope-line reveal" aria-hidden="true"></div>

    <!-- Vendredi -->
    <div class="day">
      <h2 class="day-title reveal">Vendredi</h2>

      <div class="step reveal">
        <div class="place">
          <span class="place-name">Mairie de Suresnes</span>
          <span class="place-city">Suresnes</span>
        </div>
        <div class="event">
          <span class="event-label">Mariage civil</span>
          <span class="event-time">15h00</span>
        </div>
      </div>

      <div class="step reveal">
        <div class="place">
          <span class="place-name">Restaurant Pré St-Germain</span>
          <span class="place-city">Louviers</span>
        </div>
        <div class="event">
          <span class="event-label">Dîner avec les témoins</span>
          <span class="event-time">19h30</span>
        </div>
      </div>
    </div>

    <!-- Samedi -->
    <div class="day">
      <h2 class="day-title reveal">Samedi</h2>

      <div class="step reveal">
        <div class="place">
          <span class="place-name">Église Notre-Dame de Tourny</span>
          <span class="place-city">Vexin-sur-Epte</span>
        </div>
        <div class="event">
          <span class="event-label">Culte</span>
          <span class="event-time">15h30</span>
        </div>
      </div>

      <div class="step reveal">
        <div class="place">
          <span class="place-name">Château du Chesnay-Haguest</span>
          <span class="place-city">Vexin-sur-Epte</span>
        </div>
        <div class="event">
          <span class="event-label">Vin d'honneur</span>
          <span class="event-time">18h00</span>
        </div>
      </div>

      <div class="step no-place reveal">
        <div class="place"></div>
        <div class="event">
          <span class="event-label">Dîner</span>
          <span class="event-time">20h00</span>
        </div>
      </div>

      <div class="step no-place reveal">
        <div class="place"></div>
        <div class="event">
          <span class="event-label">Soirée dansante</span>
          <span class="event-time">23h00</span>
          <span class="event-detail">Fin de la soirée à 03h00</span>
        </div>
      </div>
    </div>

    <!-- Dimanche -->
    <div class="day">
      <h2 class="day-title reveal">Dimanche</h2>

      <div class="step reveal">
        <div class="place">
          <span class="place-name">Château du Chesnay-Haguest</span>
          <span class="place-city">Vexin-sur-Epte</span>
        </div>
        <div class="event">
          <span class="event-label">Brunch</span>
          <span class="event-time">10h00</span>
        </div>
      </div>
    </div>

  </div>
</div>

<style>
  .programme {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
    padding: 0 20px 40px;
  }

  /* === Trait vertical bleu === */
  .rope-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    transform: translateX(-50%);
    z-index: 1;
    background: var(--color-slate-blue, #6B8CAE);
  }

  .day {
    position: relative;
    margin-bottom: 3rem;
  }

  .day-title {
    text-align: center;
    color: var(--color-navy-text, #2D4A6F);
    font-family: var(--font-serif);
    font-size: 1.4rem;
    text-transform: uppercase;
    letter-spacing: 3px;
    margin: 0 auto 1.75rem;
    padding: 0.6rem 1.5rem;
    max-width: 280px;
    background: var(--color-slate-blue, #6B8CAE);
    color: var(--color-cream, #F8F2E8);
    border: none;
    border-radius: 8px;
    position: relative;
    z-index: 2;
    font-weight: 400;
  }

  .step {
    display: flex;
    align-items: flex-start;
    margin-bottom: 1.75rem;
    position: relative;
    z-index: 3;
  }

  .place,
  .event {
    flex: 1 1 50%;
    padding: 0 2.5rem;
  }

  .place {
    text-align: right;
  }

  .place-name {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--color-navy-text);
    font-weight: 500;
    line-height: 1.3;
  }

  .place-city {
    display: block;
    font-style: italic;
    color: #7a6b5f;
    font-size: 0.92rem;
    margin-top: 3px;
    line-height: 1.3;
  }

  .event {
    text-align: left;
  }

  .event-label {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--color-navy-text);
    font-weight: 500;
    line-height: 1.3;
  }

  .event-time {
    display: block;
    font-weight: 600;
    color: var(--color-gold-accent, #b58a54);
    font-size: 1.15rem;
    margin-top: 4px;
    line-height: 1.3;
  }

  .event-detail {
    display: block;
    font-style: italic;
    color: #7a6b5f;
    font-size: 0.9rem;
    margin-top: 4px;
    line-height: 1.3;
  }

  /* Lignes sans lieu : on laisse la place vide à gauche */
  .step.no-place .place {
    visibility: hidden;
  }

  /* === Ronds dorés sur la timeline === */
  .step::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 12px;
    background: var(--color-gold-accent, #b58a54);
    border: 2px solid var(--color-cream, #F8F2E8);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    z-index: 10;
  }

  /* === Animations reveal === */
  .rope-line.reveal {
    opacity: 0;
    transition: opacity 1000ms ease 300ms;
  }

  .rope-line.reveal.is-visible {
    opacity: 1;
  }

  .day-title.reveal {
    opacity: 0;
    transform: scale(0.95) translateY(15px);
    transition: opacity 600ms ease, transform 600ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .day-title.reveal.is-visible {
    opacity: 1;
    transform: scale(1) translateY(0);
  }

  .step.reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 700ms ease, transform 700ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .step.reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 640px) {
    .programme {
      padding-left: 8px;
      padding-right: 8px;
    }

    .rope-line {
      left: 24px;
      transform: none;
      width: 2px;
    }

    .day-title {
      text-align: left;
      margin-left: 48px;
      margin-right: 0;
      max-width: none;
      display: inline-block;
      font-size: 1.2rem;
      padding: 0.5rem 1rem;
    }

    .step {
      flex-direction: column;
      padding-left: 52px;
      margin-bottom: 1.5rem;
    }

    /* Sur mobile, même les "no-place" n'affichant pas le lieu, on empile gauche→droite,
       mais on supprime le bloc vide pour gagner de la place. */
    .step.no-place {
      padding-left: 52px;
    }

    .place,
    .event {
      text-align: left;
      padding: 0;
      width: 100%;
    }

    .place {
      margin-bottom: 0.25rem;
    }

    .step.no-place .place {
      display: none;
    }

    .step::after {
      left: 11px;
      transform: translateY(-50%);
    }
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

  document.querySelectorAll('.rope-line, .day-title, .step').forEach((el) => observer.observe(el));

  // Stagger progressif pour les étapes (par jour)
  document.querySelectorAll('.day').forEach((day) => {
    day.querySelectorAll('.step').forEach((step, i) => {
      step.style.transitionDelay = `${Math.min(i * 0.12, 0.5)}s`;
    });
  });
</script>
