<div class="program-content">
  <div class="programme">

    <!-- Corde torsadée verticale -->
    <div class="rope-line reveal" aria-hidden="true">
      <svg class="rope-svg" width="100%" height="100%" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <filter id="strandShadow" x="-30%" y="-30%" width="160%" height="160%">
            <feGaussianBlur in="SourceAlpha" stdDeviation="0.7" result="blur"/>
            <feOffset in="blur" dx="0.6" dy="0.6" result="offsetBlur"/>
            <feFlood flood-color="#8A7050" flood-opacity="0.35" result="color"/>
            <feComposite in="color" in2="offsetBlur" operator="in" result="shadow"/>
            <feMerge>
              <feMergeNode in="shadow"/>
              <feMergeNode in="SourceGraphic"/>
            </feMerge>
          </filter>
          <pattern id="strand" width="16" height="24" patternUnits="userSpaceOnUse">
            <path d="M0,24 C0,18 4,14 8,12 C12,10 16,6 16,0" 
                  stroke="#CDBA98" stroke-width="1.0" fill="none" stroke-linecap="round"
                  filter="url(#strandShadow)"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#strand)"/>
      </svg>
    </div>

    <!-- Samedi -->
    <div class="day">
      <h2 class="day-title reveal">Samedi 29 mai</h2>

      <div class="step reveal">
        <div class="place">
          <span class="place-name">Église Notre-Dame de Tourny</span>
          <span class="place-city">Vexin-sur-Epte</span>
        </div>
        <div class="event">
          <span class="event-label">Cérémonie religieuse</span>
          <span class="event-time">15h30</span>
        </div>
      </div>

      <div class="step reveal">
        <div class="place">
          <span class="place-name">Château du Chesnay-Haguest</span>
          <span class="place-city">Vexin-sur-Epte</span>
        </div>
        <div class="event">
          <span class="event-label">Vin d'honneur</span>
          <span class="event-time">18h00</span>
        </div>
      </div>

      <div class="step no-place reveal">
        <div class="place"></div>
        <div class="event">
          <span class="event-label">Dîner</span>
          <span class="event-time">20h00</span>
        </div>
      </div>

      <div class="step no-place reveal">
        <div class="place"></div>
        <div class="event">
          <span class="event-label">Soirée dansante</span>
          <span class="event-time">23h00</span>
          <span class="event-end">(fin prévue à 03h00)</span>
        </div>
      </div>
    </div>

  </div>
</div>

<style>
  .programme {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
    padding: 0 20px 10px;
    font-family: var(--font-sans-elegant);
  }

  .rope-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 16px;
    transform: translateX(-50%);
    border-radius: 8px;
    background: #D8C8B0;
    box-shadow:
      inset 1px 0 2px rgba(100, 80, 55, 0.2),
      inset -1px 0 2px rgba(255, 255, 255, 0.25),
      1px 0 4px rgba(45, 74, 111, 0.06);
    z-index: 1;
    overflow: hidden;
  }

  .rope-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .day {
    position: relative;
    margin-bottom: 3rem;
  }

  .day-title {
    text-align: center;
    color: var(--color-navy-text, #2D4A6F);
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-variant: small-caps;
    letter-spacing: 3px;
    margin: 0 auto 1.75rem;
    padding: 0.6rem 1.5rem;
    max-width: 280px;
    background: var(--color-slate-blue, #6B8CAE);
    color: var(--color-cream, #FAF9F6);
    border: none;
    border-radius: 8px;
    position: relative;
    z-index: 2;
    font-weight: 400;
  }

  .step {
    display: flex;
    align-items: flex-start;
    margin-bottom: 1.75rem;
    position: relative;
    z-index: 3;
  }

  .place,
  .event {
    flex: 1 1 50%;
    padding: 0 2.5rem;
  }

  .place {
    text-align: right;
  }

  .place-name {
    display: block;
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-navy-text);
    font-weight: 500;
    line-height: 1.3;
  }

  .place-city {
    display: block;
    font-style: italic;
    color: #7a6b5f;
    font-size: 1.1rem;
    margin-top: 3px;
    line-height: 1.3;
  }

  .event {
    text-align: left;
  }

  .event-label {
    display: block;
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-navy-text);
    font-weight: 500;
    line-height: 1.3;
  }

  .event-time {
    display: block;
    font-weight: 500;
    color: var(--color-gold-accent, #b58a54);
    font-size: 1.1rem;
    margin-top: 4px;
    line-height: 1.3;
  }
  .event-end {
    display: block;
    font-style: italic;
    color: #7a6b5f;
    font-size: 1rem;
    margin-top: 4px;
    line-height: 1.3;
    position: relative;
  }
  .event-detail {
    display: block;
    font-style: italic;
    color: #7a6b5f;
    font-size: 1rem;
    margin-top: 4px;
    line-height: 1.3;
  }

  .step.no-place .place {
    visibility: hidden;
  }

  .step::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 0.75rem;
    width: 16px;
    height: 16px;
    background: var(--color-gold-accent, #b58a54);
    border: 2px solid var(--color-cream, #FAF9F6);
    border-radius: 50%;
    transform: translateX(-50%);
    z-index: 10;
    box-shadow: 0 2px 6px rgba(45, 74, 111, 0.2);
  }

  .rope-line.reveal {
    opacity: 0;
    transition: opacity 1000ms ease 300ms;
  }

  .rope-line.reveal.is-visible {
    opacity: 1;
  }

  .day-title.reveal {
    opacity: 0;
    transform: scale(0.95) translateY(15px);
    transition: opacity 600ms ease, transform 600ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .day-title.reveal.is-visible {
    opacity: 1;
    transform: scale(1) translateY(0);
  }

  .step.reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 700ms ease, transform 700ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .step.reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 640px) {
    .programme {
      padding-left: 8px;
      padding-right: 8px;
    }

    .rope-line {
      left: 24px;
      transform: none;
      width: 12px;
      border-radius: 6px;
    }

    .day-title {
      text-align: left;
      margin-left: 48px;
      margin-right: 0;
      max-width: none;
      display: inline-block;
      font-size: 1.2rem;
      padding: 0.5rem 1rem;
    }

    .step {
      flex-direction: column;
      padding-left: 52px;
      margin-bottom: 1.5rem;
    }

    .step.no-place {
      padding-left: 52px;
    }

    .place,
    .event {
      text-align: left;
      padding: 0;
      width: 100%;
    }

    .place {
      margin-bottom: 0.25rem;
    }

    .step.no-place .place {
      display: none;
    }

    .step::after {
      left: 11px;
      top: 0.75rem;
      transform: none;
    }
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

  document.querySelectorAll('.rope-line, .day-title, .step').forEach((el) => observer.observe(el));

  document.querySelectorAll('.day').forEach((day) => {
    day.querySelectorAll('.step').forEach((step, i) => {
      step.style.transitionDelay = `${Math.min(i * 0.12, 0.5)}s`;
    });
  });
</script>
