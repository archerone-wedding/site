---
import { actions } from 'astro:actions';
import { navItems, site } from '../data/site';

export interface Props {
	/** `bar` renders the thin top banner used by inner pages, `inline` a plain row. */
	variant?: 'bar' | 'inline';
}

const { variant = 'bar' } = Astro.props;
const group = Astro.locals.group;
---

<nav class:list={['site-nav', `site-nav--${variant}`]} aria-label="Navigation principale">
	<a class="site-nav__brand" href="/">{site.name}</a>
	<ul class="site-nav__links">
		{
			navItems.map((item) => (
				<li class:list={[{ 'has-children': item.children }]}>
					{item.href ? (
						<a
							href={item.href}
							class:list={{
								active: Astro.url.pathname.startsWith(item.href),
							}}
						>
							{item.label}
							{item.children && (
								<span class="caret" aria-hidden="true">▾</span>
							)}
						</a>
					) : (
						<button type="button" class="nav-trigger">
							{item.label}
							{item.children && (
								<span class="caret" aria-hidden="true">▾</span>
							)}
						</button>
					)}
					{item.children && (
						<ul class="submenu">
							{item.children.map((child) => (
								<li>
									<a
										href={child.href}
										class:list={{
											active:
												Astro.url.pathname === child.href ||
												Astro.url.pathname.startsWith(child.href + '/'),
										}}
									>
										{child.label}
									</a>
								</li>
							))}
						</ul>
					)}
				</li>
			))
		}
	</ul>
	{
		group && (
			<div class="site-nav__user">
				<span class="user-name">{group.name}</span>
				<form method="post" action={actions.logout} class="logout-form">
					<button type="submit" class="user-logout" title="Changer d'utilisateur">
						×
					</button>
				</form>
			</div>
		)
	}
</nav>

<style>
	.site-nav {
		display: flex;
		align-items: center;
		gap: 2rem;
		max-width: 1200px;
		margin: 0 auto;
	}

	.site-nav--bar {
		padding: 0.6rem 1.5rem;
		border-bottom: 1px solid rgba(47, 42, 38, 0.12);
	}

	.site-nav--inline {
		gap: 1.25rem;
		padding: 0;
	}

	.site-nav__brand {
		font-weight: 600;
		color: var(--color-goldenrod);
		text-decoration: none;
		white-space: nowrap;
	}

	.site-nav--inline .site-nav__brand {
		display: none;
	}

	.site-nav__links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.5rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.site-nav__links > li > a,
	.site-nav__links > li > .nav-trigger {
		display: inline-flex;
		align-items: center;
		padding: 0.3rem 0;
		color: var(--color-goldenrod);
		text-decoration: none;
		font-size: 0.9rem;
		background: none;
		border: none;
		cursor: pointer;
		font-family: inherit;
	}

	.site-nav__links a:hover,
	.site-nav__links a.active,
	.site-nav__links .nav-trigger:hover {
		color: var(--color-prussian-blue);
	}

	.site-nav__links > li > a.active {
		border-bottom: 1px solid currentColor;
	}

	/* Dropdown */
	.site-nav__links li.has-children {
		position: relative;
	}

	.caret {
		font-size: 0.65rem;
		margin-left: 0.25rem;
		opacity: 0.6;
	}

	.submenu {
		position: absolute;
		top: calc(100% + 0.35rem);
		left: 50%;
		transform: translateX(-50%);
		min-width: 10rem;
		background: var(--color-dusty-denim);
		border: 1px solid rgba(47, 42, 38, 0.12);
		border-radius: 0.4rem;
		padding: 0.35rem 0;
		list-style: none;
		box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition: opacity 150ms ease, visibility 150ms ease;
		z-index: 100;
	}

	.submenu a {
		display: block;
		padding: 0.45rem 1rem;
		white-space: nowrap;
		font-size: 0.9rem;
		color: var(--color-soft-linen);
		text-decoration: none;
	}

	.submenu a:hover,
	.submenu a.active {
		color: var(--color-ink);
	}

	.submenu a.active {
		background: rgba(47, 42, 38, 0.05);
		border-radius: 0.25rem;
	}

	.site-nav__links li.has-children:hover > .submenu,
	.site-nav__links li.has-children:focus-within > .submenu {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
	}

	/* User badge */
	.site-nav__user {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-left: auto;
		font-size: 0.85rem;
		color: var(--color-muted);
	}

	.user-name {
		max-width: 120px;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.logout-form {
		display: inline;
		margin: 0;
		padding: 0;
	}

	.user-logout {
		background: none;
		border: none;
		color: var(--color-muted);
		font-size: 1.1rem;
		line-height: 1;
		cursor: pointer;
		padding: 0.15rem 0.35rem;
		border-radius: 0.25rem;
	}

	.user-logout:hover {
		color: var(--color-ink);
		background: rgba(47, 42, 38, 0.06);
	}

	@media (max-width: 720px) {
		.site-nav--bar {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.35rem;
			padding: 0.6rem 1.25rem 0.75rem;
		}

		.site-nav__links {
			gap: 0.25rem 1rem;
		}

		.site-nav--inline {
			gap: 0.25rem 1rem;
		}

		.submenu {
			position: static;
			transform: none;
			box-shadow: none;
			border: none;
			background: transparent;
			padding: 0.1rem 0 0 0.75rem;
			opacity: 1;
			visibility: visible;
			pointer-events: auto;
		}

		.submenu a {
			padding: 0.25rem 0;
			font-size: 0.85rem;
		}

		.caret {
			display: none;
		}

		.site-nav__user {
			margin-left: 0;
			width: 100%;
			padding-top: 0.35rem;
			border-top: 1px solid rgba(47, 42, 38, 0.08);
		}
	}

	@media (max-width: 380px) {
		.site-nav__brand {
			font-size: 0.95rem;
		}

		.site-nav__links > li > a,
		.site-nav__links > li > .nav-trigger {
			font-size: 0.85rem;
		}
	}
</style>
