---
import { actions } from 'astro:actions';
import { navItems } from '../data/site';

export interface Props {
	/** `bar` renders the thin top banner used by inner pages, `inline` a plain row. */
	variant?: 'bar' | 'inline';
	/** Hide the brand/logo link (useful for landing page). */
	hideBrand?: boolean;
	/** Custom brand image path. Defaults to the navy-background monogram. */
	brandImage?: string;
	/** Render the brand as a plain <span> (no link). */
	noBrandLink?: boolean;
}

const { variant = 'bar', hideBrand = false, brandImage = '/img/Monogramme2.png', noBrandLink = false } = Astro.props;
const group = Astro.locals.group;
---

<nav class:list={['site-nav', `site-nav--${variant}`]} aria-label="Navigation principale">
	{!hideBrand && noBrandLink && (
		<span class="site-nav__brand">
			<img src={brandImage} alt="T & C" />
		</span>
	)}
	{!hideBrand && !noBrandLink && (
		<a class="site-nav__brand" href="/">
			<img src={brandImage} alt="T & C" />
		</a>
	)}

	<button
		class="nav-toggle"
		type="button"
		aria-label="Ouvrir le menu"
		aria-expanded="false"
		aria-controls="site-nav-menu"
		data-nav-toggle
	>
		<span class="nav-toggle__bar" aria-hidden="true"></span>
		<span class="nav-toggle__bar" aria-hidden="true"></span>
		<span class="nav-toggle__bar" aria-hidden="true"></span>
	</button>

	<div class="site-nav__menu" id="site-nav-menu">
		<ul class="site-nav__links">
			{
				navItems.map((item) => (
					<li class:list={[{ 'has-children': item.children }]}>
						{item.href ? (
							<a
								href={item.href}
								class:list={{
									active: Astro.url.pathname.startsWith(item.href),
								}}
							>
								{item.label}
								{item.children && (
									<span class="caret" aria-hidden="true">▾</span>
								)}
							</a>
						) : (
							<button
								type="button"
								class:list={[
									'nav-trigger',
									{ active: item.children && item.children.some(child => Astro.url.pathname === child.href || Astro.url.pathname.startsWith(child.href + '/')) },
								]}
								data-submenu-toggle
								aria-expanded="false"
							>
								{item.label}
								{item.children && (
									<span class="caret" aria-hidden="true">▾</span>
								)}
							</button>
						)}
						{item.children && (
							<ul class="submenu">
								{item.children.map((child) => (
									<li>
										<a
											href={child.href}
											class:list={{
												active:
													Astro.url.pathname === child.href ||
													Astro.url.pathname.startsWith(child.href + '/'),
											}}
										>
											{child.label}
										</a>
									</li>
								))}
								</ul>
							)}
						</li>
					)
				)
			}
		</ul>
		{
			group && (
				<div class="site-nav__user">
					<form method="post" action={actions.logout} class="logout-form">
						<button type="submit" class="user-logout" aria-label="Se déconnecter">
							<span aria-hidden="true">⏻</span>
						</button>
					</form>
				</div>
			)
		}
	</div>
</nav>

<style>
	.site-nav {
		display: flex;
		align-items: center;
		gap: 2rem;
		max-width: 1200px;
		margin: 0 auto;
		position: relative;
	}

	.site-nav--bar {
		padding: 0.6rem 1.5rem;
		background: var(--color-navy);
	}

	.site-nav--inline {
		gap: 1.25rem;
		padding: 0.6rem 1.5rem;
		background: var(--color-navy);
	}

	.site-nav__brand {
		display: flex;
		align-items: center;
		color: var(--color-white);
		text-decoration: none;
		white-space: nowrap;
		letter-spacing: normal;
	}

	.site-nav__brand img {
		height: 2rem;
		width: auto;
		display: block;
	}

	/* === Bouton hamburger === */
	.nav-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 5px;
		width: 2.2rem;
		height: 2.2rem;
		padding: 0;
		background: none;
		border: none;
		cursor: pointer;
		margin-left: auto;
		z-index: 102;
	}

	.nav-toggle__bar {
		display: block;
		width: 1.5rem;
		height: 2px;
		background: var(--color-white);
		border-radius: 2px;
		transition: transform 200ms ease, opacity 200ms ease;
	}

	.nav-toggle.is-open .nav-toggle__bar:nth-child(1) {
		transform: translateY(7px) rotate(45deg);
	}

	.nav-toggle.is-open .nav-toggle__bar:nth-child(2) {
		opacity: 0;
	}

	.nav-toggle.is-open .nav-toggle__bar:nth-child(3) {
		transform: translateY(-7px) rotate(-45deg);
	}

	/* === Menu (conteneur) === */
	.site-nav__menu {
		display: flex;
		align-items: center;
		flex: 1;
		gap: inherit;
	}

	.site-nav__links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.5rem;
		list-style: none;
		margin: 0;
		padding: 0;
		font-family: var(--font-display);
		font-variant: small-caps;
		letter-spacing: 0.04em;
	}

	.site-nav__links > li > a,
	.site-nav__links > li > .nav-trigger {
		display: inline-flex;
		align-items: center;
		padding: 0.3rem 0;
		color: var(--color-white);
		text-decoration: none;
		font-size: 0.95rem;
		background: none;
		border: none;
		cursor: pointer;
		font-family: inherit;
		font-variant: small-caps;
		letter-spacing: 0.04em;
		line-height: 1;
		vertical-align: middle;
	}

	.site-nav__links > li > a,
	.site-nav__links > li > .nav-trigger {
		border-bottom: 1px solid transparent;
		transition: border-color 250ms ease, color 250ms ease;
	}

	.site-nav__links > li > a:hover,
	.site-nav__links > li > .nav-trigger:hover {
		border-bottom: 1px solid var(--color-white);
	}

	.site-nav__links > li > a.active,
	.site-nav__links > li > .nav-trigger.active {
		border-bottom: 1px solid var(--color-white);
	}


	/* Empêche tout flash de police au clic / focus */
	.site-nav__links a,
	.site-nav__links a:active,
	.site-nav__links a:focus,
	.site-nav__links .nav-trigger,
	.site-nav__links .nav-trigger:active,
	.site-nav__links .nav-trigger:focus,
	.submenu a,
	.submenu a:active,
	.submenu a:focus {
		font-family: inherit;
	}

	/* Dropdown */
	.site-nav__links li.has-children {
		position: relative;
	}

	.site-nav__links li.has-children::after {
		content: '';
		position: absolute;
		top: 100%;
		left: 0;
		width: 100%;
		height: 0.6rem;
		background: transparent;
		z-index: 99;
		pointer-events: auto;
	}

	.caret {
		font-size: 0.65rem;
		margin-left: 0.25rem;
		opacity: 0.6;
	}

	.submenu {
		position: absolute;
		top: calc(100% + 0.35rem);
		left: 50%;
		transform: translateX(-50%);
		background: var(--color-cream);
		border: 1px solid rgba(45, 74, 111, 0.12);
		border-radius: 0.4rem;
		padding: 0.35rem 0.5rem;
		list-style: none;
		box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition: opacity 150ms ease, visibility 150ms ease;
		z-index: 100;
		display: flex;
		align-items: center;
		flex-wrap: nowrap;
		gap: 0.15rem;
		width: max-content;
		max-width: none;
	}

	.submenu a {
		display: inline-block;
		padding: 0.45rem 0.75rem;
		white-space: nowrap;
		font-size: 0.9rem;
		color: var(--color-navy);
		text-decoration: none;
		border-radius: 0.25rem;
	}

	.submenu a:hover,
	.submenu a.active {
		color: var(--color-navy);
		background: rgba(45, 74, 111, 0.08);
	}

	.site-nav__links li.has-children:hover > .submenu,
	.site-nav__links li.has-children:focus-within > .submenu {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
	}

	/* User badge */
	.site-nav__user {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-left: auto;
		font-size: 0.85rem;
		color: rgba(255, 255, 255, 0.75);
	}

	.logout-form {
		display: inline;
		margin: 0;
		padding: 0;
	}

	.user-logout {
		background: none;
		border: none;
		color: rgba(255, 255, 255, 0.75);
		font-family: var(--font-display), system-ui, sans-serif;
		font-size: 1.25rem;
		line-height: 1;
		cursor: pointer;
		padding: 0.15rem 0.25rem;
		border-radius: 0.25rem;
	}

	.user-logout:hover {
		color: var(--color-white);
		background: rgba(255, 255, 255, 0.15);
	}

	/* === Desktop centré === */
	@media (min-width: 721px) {
		.site-nav {
			justify-content: center;
		}
		.site-nav__brand {
			position: absolute;
			left: 0;
			top: 50%;
			transform: translateY(-50%);
			font-size: 0; /* collapse inline gap */
		}
		.site-nav__brand img {
			height: 2.4rem;
		}
		.site-nav__menu {
			flex: none;
		}
		.site-nav__user {
			position: absolute;
			right: 0;
			top: 50%;
			transform: translateY(-50%);
			margin-left: 0;
		}
	}

	/* === Mobile === */
	@media (max-width: 720px) {
		.site-nav--bar {
			flex-wrap: wrap;
			padding: 0.6rem 1.25rem;
		}

		.nav-toggle {
			display: flex;
		}

		.site-nav.is-menu-open .site-nav__brand {
			display: none;
		}

		.site-nav__menu {
			display: none;
			position: fixed;
			inset: 0;
			width: 100vw;
			height: 100vh;
			background: rgba(45, 74, 111, 0.95);
			z-index: 101;
			padding: 5rem 1.5rem 2rem;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			gap: 1.5rem;
		}

		.site-nav__menu.is-open {
			display: flex;
		}

		.site-nav__links {
			flex-direction: column;
			align-items: center;
			gap: 1rem;
		}

		.site-nav__links > li > a,
		.site-nav__links > li > .nav-trigger {
			font-size: 1.35rem;
			padding: 0.4rem 0;
			justify-content: center;
		}

		.site-nav__user {
			margin-left: 0;
			padding-top: 1rem;
			border-top: 1px solid rgba(255, 255, 255, 0.12);
			width: 100%;
			justify-content: center;
		}

		.submenu {
			position: static;
			transform: none;
			box-shadow: none;
			border: none;
			background: transparent;
			padding: 0.5rem 0 0 0;
			display: none;
			text-align: center;
		}

		.submenu.is-open {
			display: block;
		}

		.submenu li {
			text-align: center;
		}

		.submenu a {
			padding: 0.35rem 0;
			font-size: 1.05rem;
		}

		/* Caret / triangle inversé en mobile */
		.caret {
			font-size: 0.75rem;
			margin-left: 0.4rem;
			opacity: 0.7;
			transition: transform 200ms ease;
			display: inline-block;
		}

		.nav-trigger[aria-expanded="true"] .caret,
		[data-submenu-toggle].is-open .caret {
			transform: rotate(180deg);
		}

		.submenu {
			position: static;
			transform: none;
			box-shadow: none;
			border: none;
			background: transparent;
			padding: 0.1rem 0 0 0.75rem;
			opacity: 1;
			visibility: visible;
			pointer-events: auto;
		}

		.submenu a {
			padding: 0.25rem 0;
			font-size: 0.85rem;
		}

		.caret {
			display: none;
		}
	}

	@media (max-width: 380px) {
		.site-nav__brand img {
			height: 1.9rem;
		}

		.site-nav__links > li > a,
		.site-nav__links > li > .nav-trigger {
			font-size: 0.85rem;
		}
	}
</style>

<script>
	const toggle = document.querySelector('[data-nav-toggle]') as HTMLButtonElement | null;
	const menu = document.getElementById('site-nav-menu');
	const nav = document.querySelector('.site-nav');
	if (toggle && menu) {
		toggle.addEventListener('click', () => {
			const isOpen = menu.classList.toggle('is-open');
			toggle.classList.toggle('is-open', isOpen);
			if (nav) nav.classList.toggle('is-menu-open', isOpen);
			toggle.setAttribute('aria-expanded', String(isOpen));
			document.body.style.overflow = isOpen ? 'hidden' : '';
			const bars = toggle.querySelectorAll('.nav-toggle__bar');
			bars.forEach((bar) => bar.classList.toggle('is-open', isOpen));
		});
	}

	// Accordéon sous-menus (mobile)
	document.querySelectorAll<HTMLElement>('[data-submenu-toggle]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const parent = btn.closest('li');
			if (!parent) return;
			const submenu = parent.querySelector<HTMLElement>('.submenu');
			if (!submenu) return;
			submenu.classList.toggle('is-open');
			btn.classList.toggle('is-open');
			const isExpanded = btn.classList.contains('is-open');
			btn.setAttribute('aria-expanded', String(isExpanded));
		});
	});
</script>
