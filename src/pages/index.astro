---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import { site } from '../data/site';

const group = Astro.locals.group;
---

<Layout hideFooter={true}>
	<div slot="header" class="landing-nav">
		<SiteNav variant="inline" />
	</div>

	<section class="hero">
		<div class="hero-bg" role="img" aria-label={site.name}></div>
		<div class="hero-overlay"></div>
		<div class="hero-panel">
			<h1 class="reveal" data-delay="0">{site.nameLines[0]} <span class="amp">&amp;</span> {site.nameLines[1]}</h1>
			<div class="hero-separator reveal" data-delay="1"></div>
			<p class="date reveal" data-delay="2">29 mai 2027</p>
		</div>
	</section>


</Layout>

<script>
	const observer = new IntersectionObserver((entries) => {
		entries.forEach((entry) => {
			if (entry.isIntersecting) {
				entry.target.classList.add('is-visible');
				observer.unobserve(entry.target);
			}
		});
	}, { threshold: 0.15 });

	document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
</script>

<style>
	@font-face {
		font-family: 'Annabel Script';
		src: url('/fonts/AnnabelScript.woff2') format('woff2'),
		     url('/fonts/AnnabelScript.woff') format('woff');
		font-weight: 400;
		font-style: normal;
		font-display: swap;
	}

	.landing-nav {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		background: transparent;
	}

	.landing-nav :global(.site-nav--inline) {
		background: transparent;
	}

	.hero {
		position: relative;
		display: flex;
		align-items: flex-end;
		justify-content: center;
		width: 100%;
		height: 100dvh;
		margin: 0;
		padding: 0 0 18vh;
		overflow: hidden;
	}

	.hero-bg {
		position: absolute;
		inset: 0;
		background-image: url('/img/IMG-20261027.jpg');
		background-size: cover;
		background-position: center;
	}

	.hero-overlay {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.35);
		z-index: 1;
	}

	.hero-panel {
		position: relative;
		z-index: 2;
		color: var(--color-white);
		padding: 2rem;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
	}

	.hero-panel > * {
		position: relative;
		z-index: 1;
	}

	h1 {
		margin: 0 0 1.5rem;
		font-family: 'Annabel Script', var(--font-script);
		font-style: normal;
		font-weight: 400;
		font-size: clamp(2.5rem, 6vw, 4.5rem);
		line-height: 1.1;
		color: var(--color-white);
		letter-spacing: 0.02em;
		text-shadow: 0 2px 12px rgba(0, 0, 0, 0.4);
	}

	.amp {
		font-family: 'Annabel Script', var(--font-script);
		font-style: normal;
		font-size: 0.85em;
		color: var(--color-white);
	}

	.hero-separator {
		width: 120px;
		height: 1px;
		background: var(--color-white);
		margin: 0 0 1.5rem;
		opacity: 0.7;
	}

	.date {
		margin: 0;
		font-size: clamp(1.4rem, 3.5vw, 2.2rem);
		font-family: 'Annabel Script', var(--font-script);
		font-weight: 400;
		letter-spacing: 0.04em;
		text-transform: none;
		color: var(--color-white);
		text-shadow: 0 1px 8px rgba(0, 0, 0, 0.4);
	}

	/* ========== Animations reveal ========== */
	.reveal {
		opacity: 0;
		transform: translateY(30px);
		transition: opacity 800ms cubic-bezier(0.25, 0.46, 0.45, 0.94),
					transform 800ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
	}

	.reveal.is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	/* Séparateur : ligne qui se dessine */
	.hero-separator.reveal {
		transform: scaleX(0);
		transform-origin: center center;
		transition: opacity 600ms ease, transform 800ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
	}

	.hero-separator.reveal.is-visible {
		transform: scaleX(1);
	}

	/* Délais staggered */
	.reveal[data-delay="1"].is-visible { transition-delay: 0.12s; }
	.reveal[data-delay="2"].is-visible { transition-delay: 0.24s; }
	.reveal[data-delay="3"].is-visible { transition-delay: 0.36s; }
	.reveal[data-delay="4"].is-visible { transition-delay: 0.48s; }

	@media (max-width: 860px) {
		.hero {
			padding-bottom: 12vh;
		}

		h1 {
			margin-bottom: 1.25rem;
		}

		.hero-separator {
			width: 80px;
		}
	}

	@media (max-width: 420px) {
		.hero {
			padding-bottom: 10vh;
		}

		.hero-panel {
			padding: 1.5rem;
		}

		.date {
			font-size: 1rem;
		}
	}
</style>
