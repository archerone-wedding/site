---
import PageLayout from '../layouts/PageLayout.astro';
import { site } from '../data/site';
---

<PageLayout title={`Liste de mariage — ${site.name}`}>
	<section class="page">
		<div class="page-header">
			<h1 class="reveal">Liste de mariage</h1>
			<div class="section-separator reveal-line"></div>
        </div>

        <p class="intro reveal">
            Nous avons choisi de ne pas créer de liste de mariage.
        </p>

        <p class="intro reveal">
            En revanche, si vous souhaitez nous faire un cadeau, nous serions très touchés que vous participiez à notre voyage de noces.
        </p>

        <p class="intro reveal">
            Vos gestes, quels qu'ils soient, comptent énormément pour nous. Merci du fond du cœur.
        </p>
	</section>
</PageLayout>

<style>
	.page {
		max-width: 960px;
		margin: 0 auto;
		padding: 3rem 1.5rem 4rem;
		font-family: var(--font-sans-elegant);
	}

	h1 {
		margin: 0 0 0.75rem;
		font-family: var(--font-display);
		font-style: italic;
		font-weight: 500;
		font-size: clamp(1.8rem, 4vw, 2.4rem);
		color: var(--color-navy-text);
		letter-spacing: 0.02em;
	}

	.page-header {
		display: inline-block;
		vertical-align: top;
	}

	.page-header h1 {
		margin-bottom: 0.75rem;
	}

	.section-separator {
		width: 100%;
		height: 1px;
		background: var(--color-navy-text);
		opacity: 0.35;
		margin: 0 0 2.5rem;
	}

	.intro {
		margin: 0 0 1.25rem;
		font-size: 1.05rem;
		line-height: 1.65;
		color: var(--color-brown);
	}

	@media (max-width: 720px) {
		.page {
			padding: 2rem 1.25rem 3rem;
		}
	}

	/* ========== Animations reveal ========== */
	.reveal {
		opacity: 0;
		transform: translateY(25px);
		transition: opacity 700ms cubic-bezier(0.25, 0.46, 0.45, 0.94),
					transform 700ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
	}

	.reveal.is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	.section-separator.reveal-line {
		transform: scaleX(0);
		transform-origin: center;
		transition: transform 800ms cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.15s;
	}

	.section-separator.reveal-line.is-visible {
		transform: scaleX(1);
	}
</style>

<script>
	const observer = new IntersectionObserver((entries) => {
		entries.forEach((entry) => {
			if (entry.isIntersecting) {
				entry.target.classList.add('is-visible');
				observer.unobserve(entry.target);
			}
		});
	}, { threshold: 0.15 });

	document.querySelectorAll('.reveal, .reveal-line').forEach((el) => observer.observe(el));
</script>
