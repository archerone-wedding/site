---
import { actions } from 'astro:actions';
import { isActionError } from 'astro:actions';
import { eq } from 'drizzle-orm';
import { db } from '../db/client';
import { guestGroup } from '../db/schema';
import { createSession, verifySession } from '../auth/session';
import { checkLoginRateLimit } from '../auth/login-rate-limit';

const ADMIN_SECRET = import.meta.env.ADMIN_SECRET;
// Dev-only convenience password. Only ever checked when import.meta.env.DEV is true, so it has
// no effect in production regardless of whether ADMIN_SECRET is configured.
const DEV_BACKDOOR = 'admin-mariage-2027';
const COOKIE_NAME = 'wedding_admin';
const ADMIN_SESSION_TTL_SECONDS = 60 * 60 * 4; // 4 heures

function validatePassword(password: string): boolean {
	return (!!ADMIN_SECRET && password === ADMIN_SECRET)
		|| (import.meta.env.DEV && password === DEV_BACKDOOR);
}

let loginError = false;

// Handle POST from login or logout forms
if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const formAction = form.get('_action')?.toString();

	if (formAction === 'logout') {
		Astro.cookies.delete(COOKIE_NAME, { path: '/admin' });
		return Astro.redirect('/admin');
	}

	if (formAction === 'login') {
		const password = form.get('secret')?.toString() ?? '';
		try {
			const allowed = await checkLoginRateLimit(Astro.clientAddress, 'admin', 5, 15 * 60);
			if (allowed && validatePassword(password)) {
				Astro.cookies.set(COOKIE_NAME, createSession('admin', {}, ADMIN_SESSION_TTL_SECONDS), {
					httpOnly: true,
					path: '/admin',
					sameSite: 'strict',
					secure: import.meta.env.PROD,
					maxAge: ADMIN_SESSION_TTL_SECONDS,
				});
				return Astro.redirect('/admin');
			}
		} catch {
			// Treat unavailable rate limiting exactly like invalid credentials.
		}
		loginError = true;
	}
}

const adminCookieRaw = Astro.cookies.get(COOKIE_NAME)?.value;
const adminSession = verifySession(adminCookieRaw, 'admin');
const isAdmin = !!adminSession;

// Reject (and clear) any cookie that is not a valid signed admin session — this includes the
// old static 'authenticated' value, which must no longer be accepted.
if (adminCookieRaw && !isAdmin) {
	Astro.cookies.delete(COOKIE_NAME, { path: '/admin' });
}

let groups: Awaited<ReturnType<typeof db.select>> = [];
if (isAdmin) {
	groups = await db.select().from(guestGroup).orderBy(guestGroup.id);
}

const createResult = Astro.getActionResult(actions.createGroup);
const createError =
	createResult?.error && isActionError(createResult.error)
		? createResult.error.message
		: null;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Admin — Mariage</title>
		<style>
			@import url('https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Great+Vibes&family=Raleway:wght@300;400;500;600&display=swap');
			:root {
				--color-cream: #FDFCFA;
				--color-ink: #2f2a26;
				--color-teal: #47666f;
				--color-teal-dark: #3a565e;
				--color-muted: #7c756e;
				--font-display: 'Cormorant', serif;
				--font-sans-elegant: 'Raleway', sans-serif;
			}
			* { box-sizing: border-box; }
			body {
				margin: 0;
				min-height: 100dvh;
				background: var(--color-cream);
				color: var(--color-ink);
				font-family: var(--font-sans-elegant);
				line-height: 1.5;
				padding: 2rem 1.5rem;
				max-width: 800px;
				margin-inline: auto;
			}
			h1 { font-family: var(--font-display); font-weight: 400; font-style: italic; font-size: 2rem; margin: 0 0 1.5rem; }
			label { display: block; margin-bottom: 0.25rem; font-size: 0.85rem; color: var(--color-muted); }
			input, textarea, select {
				width: 100%;
				padding: 0.6rem 0.8rem;
				font-size: 1rem;
				border: 1px solid rgba(47,42,38,0.2);
				border-radius: 0.35rem;
				margin-bottom: 1rem;
				font-family: inherit;
				background: #fff;
			}
			button {
				padding: 0.6rem 1.2rem;
				font-size: 1rem;
				background: var(--color-teal);
				color: #fff;
				border: none;
				border-radius: 0.35rem;
				cursor: pointer;
				font-family: inherit;
			}
			button:hover { background: var(--color-teal-dark); }
			.error { color: #c0392b; font-size: 0.9rem; margin-top: -0.5rem; margin-bottom: 1rem; }
			table { width: 100%; border-collapse: collapse; margin-top: 2rem; font-size: 0.9rem; }
			th, td { text-align: left; padding: 0.6rem 0.5rem; border-bottom: 1px solid rgba(47,42,38,0.1); }
			th { color: var(--color-muted); font-weight: 500; }
			code { background: rgba(47,42,38,0.06); padding: 0.15rem 0.4rem; border-radius: 0.25rem; font-size: 0.85rem; }
			.logout { color: var(--color-teal); text-decoration: underline; cursor: pointer; background:none; border:none; padding:0; font-size:0.9rem; }
			.gate { max-width: 360px; margin: 8rem auto; text-align: center; }
			.gate input { margin-bottom: 0.75rem; }
		</style>
	</head>
	<body>
		{
			!isAdmin ? (
				<div class="gate">
					<h1>Admin</h1>
					<p style="color:var(--color-muted); margin:0 0 1.25rem;">
						Entrez le mot de passe pour accéder à l'administration.
					</p>
					<form method="post">
						<input type="hidden" name="_action" value="login" />
						<input type="password" name="secret" placeholder="Mot de passe" required autofocus />
						{loginError && <p class="error">Mot de passe incorrect.</p>}
						<button type="submit">Entrer</button>
					</form>
				</div>
			) : (
				<>
					<div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:1.5rem;">
						<h1 style="margin:0;">Invités</h1>
						<form method="post">
							<input type="hidden" name="_action" value="logout" />
							<button type="submit" class="logout">Déconnexion</button>
						</form>
					</div>
					<form method="post" action={actions.createGroup}>
						<label for="name">Nom du groupe</label>
						<input type="text" id="name" name="name" required />

						<label for="email">E-mail</label>
						<input type="email" id="email" name="email" required />

						<label for="program">Programme personnalisé</label>
						<textarea id="program" name="program" rows="3" />

						<label style="display:flex;align-items:center;gap:0.4rem;margin-bottom:1rem;">
							<input type="checkbox" name="plusOneAllowed" value="true" />
							Peut amener un +1
						</label>

						<label for="category">Catégorie d'invitation</label>
						<select id="category" name="category">
							<option value="A" selected>A — Vin d'honneur, dîner et brunch</option>
							<option value="B">B — Vin d'honneur, dîner et brunch</option>
							<option value="C">C — Vin d'honneur et dîner</option>
							<option value="D">D — Vin d'honneur uniquement</option>
						</select>

						{createError && <p class="error">{createError}</p>}
						{createResult?.data && (
							<p style="color:var(--color-teal);margin:0 0 1rem;">
								Groupe créé — code : <code>{createResult.data.code}</code>
							</p>
						)}
						<button type="submit">Ajouter le groupe</button>
					</form>

					<table>
						<thead>
							<tr>
								<th>Nom</th>
								<th>Code</th>
								<th>Email</th>
								<th>Actif</th>
								<th>Catégorie</th>
								<th />
							</tr>
						</thead>
						<tbody>
							{groups.map((g) => (
								<tr>
									<td>{g.name}</td>
									<td><code>{g.accessCode}</code></td>
									<td>{g.email}</td>
									<td>{g.isActive ? 'Oui' : 'Non'}</td>
									<td>{g.category}</td>
									<td>
										<form method="post" action={actions.deleteGroup} style="display:inline">
											<input type="hidden" name="id" value={g.id} />
											<button type="submit" class="logout" data-confirm="Supprimer ?">
												Supprimer
											</button>
										</form>
									</td>
								</tr>
							))}
							</tbody>
						</table>
					</>
				)
			}
		</body>
	</html>

<script>
	document.addEventListener('submit', (event) => {
		const form = event.target;
		if (form instanceof HTMLFormElement && form.querySelector('[data-confirm]')) {
			if (!window.confirm(form.querySelector('[data-confirm]')?.getAttribute('data-confirm') ?? '')) {
				event.preventDefault();
			}
		}
	});
</script>
