---
import PageLayout from '../layouts/PageLayout.astro';
import { site } from '../data/site';
---

<PageLayout title={`Logements — ${site.name}`}>
	<section class="page">
		<div class="page-header">
			<h1 class="reveal">Logements</h1>
			<div class="section-separator reveal-line"></div>
		</div>
		<p class="intro reveal">
			Vous trouverez ci-dessous une liste de logements situés à proximité du lieu de réception.
		</p>

		<div class="lodging-table reveal">
			<table>
				<thead>
					<tr>
						<th>Établissement</th>
						<th >Distance</th>
						<th>Couchages</th>
						<th>Répartition</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td><a href="https://leclosdesmartines.com/fr/" target="_blank" rel="noopener noreferrer">LE CLOS DES MARTINES <span class="arrow">›</span></a></td>
						<td>1,6 km</td>
						<td class="num">16</td>
						<td>1 gîte</td>
					</tr>
					<tr>
						<td><a href="https://www.maison-saint-nicolas.com/" target="_blank" rel="noopener noreferrer">LA MAISON SAINT NICOLAS <span class="arrow">›</span></a></td>
						<td>5,6 km</td>
						<td class="num">30</td>
						<td>2 gîtes, 23 et 7 couchages</td>
					</tr>
					<tr>
						<td><a href="https://www.labicoquenormande.fr/" target="_blank" rel="noopener noreferrer">LA BICOQUE NORMANDE <span class="arrow">›</span></a></td>
						<td>5,6 km</td>
						<td class="num">4</td>
						<td>1 gîte, au bord de l'eau</td>
					</tr>
					<tr>
						<td><a href="https://www.gites-de-france.com/fr/normandie/eure/gite-du-lion-dor-27g1100" target="_blank" rel="noopener noreferrer">GÎTE DU LION D'OR <span class="arrow">›</span></a></td>
						<td>6,5 km</td>
						<td class="num">15</td>
						<td>1 gîte</td>
					</tr>
					<tr>
						<td><a href="https://www.clos-saint-paul.com/" target="_blank" rel="noopener noreferrer">LE CLOS SAINT PAUL <span class="arrow">›</span></a></td>
						<td>7,4 km</td>
						<td class="num">10</td>
						<td>1 gîte et 2 chambres</td>
					</tr>
					<tr>
						<td><a href="https://maisonsdesamis.fr/" target="_blank" rel="noopener noreferrer">LA MAISON DES AMIS <span class="arrow">›</span></a></td>
						<td>10,6 km</td>
						<td class="num">22</td>
						<td>2 gîtes, 10 et 12 couchages</td>
					</tr>
					<tr>
						<td><a href="https://www.greengo.voyage/hote/l-abaca-gites" target="_blank" rel="noopener noreferrer">L'ABACA GÎTES <span class="arrow">›</span></a></td>
						<td>13,7 km</td>
						<td class="num">16</td>
						<td>4 gîtes, de 2 à 6 couchages</td>
					</tr>
				</tbody>
			</table>
		</div>
	</section>
</PageLayout>

<style>
	.page {
		max-width: 960px;
		margin: 0 auto;
		padding: 3rem 1.5rem 4rem;
		font-family: var(--font-sans-elegant);
	}

	h1 {
		margin: 0 0 0.75rem;
		font-family: var(--font-display);
		font-style: italic;
		font-weight: 500;
		font-size: clamp(1.8rem, 4vw, 2.4rem);
		color: var(--color-navy-text);
		letter-spacing: 0.02em;
	}

	.page-header {
		display: inline-block;
		vertical-align: top;
	}

	.page-header h1 {
		margin-bottom: 0.75rem;
	}

	.section-separator {
		width: 100%;
		height: 1px;
		background: var(--color-navy-text);
		opacity: 0.35;
		margin: 0 0 2.5rem;
	}

	.intro {
		margin: 0 0 2rem;
		font-size: 1.05rem;
		line-height: 1.65;
		color: var(--color-brown);
	}

	.intro strong {
		font-weight: 600;
		color: var(--color-navy-text);
	}

	.lodging-table {
		width: 100%;
		overflow-x: auto;
	}

	table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.98rem;
	}

	th, td {
		padding: 1.1rem 0.75rem;
		text-align: left;
		border-bottom: 1px solid rgba(93, 74, 61, 0.12);
		vertical-align: top;
	}

	th {
		font-weight: 500;
		font-size: 0.8rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-goldenrod, #b58a54);
		border-bottom-width: 2px;
	}

	th.num,
	td.num {
		text-align: center;
		width: 7rem;
	}

	td a {
		color: var(--color-brown);
		text-decoration: none;
		font-weight: 500;
		letter-spacing: 0.04em;
		font-size: 0.9rem;
		text-transform: uppercase;
	}

	td a:hover {
		color: var(--color-navy-text);
	}

	.arrow {
		font-size: 1rem;
		margin-left: 0.4rem;
		color: var(--color-gold-accent);
		opacity: 0.7;
	}

	tr:last-child td {
		border-bottom: none;
	}

	@media (max-width: 720px) {
		.page {
			padding: 2rem 1.25rem 3rem;
		}

		th, td {
			padding: 0.85rem 0.5rem;
			font-size: 0.9rem;
		}

		th {
			font-size: 0.7rem;
		}

		td a {
			font-size: 0.82rem;
		}
	}

	/* ========== Animations reveal ========== */
	.reveal {
		opacity: 0;
		transform: translateY(25px);
		transition: opacity 700ms cubic-bezier(0.25, 0.46, 0.45, 0.94),
					transform 700ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
	}

	.reveal.is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	.section-separator.reveal-line {
		transform: scaleX(0);
		transform-origin: center;
		transition: transform 800ms cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.15s;
	}

	.section-separator.reveal-line.is-visible {
		transform: scaleX(1);
	}
</style>

<script>
	const observer = new IntersectionObserver((entries) => {
		entries.forEach((entry) => {
			if (entry.isIntersecting) {
				entry.target.classList.add('is-visible');
				observer.unobserve(entry.target);
			}
		});
	}, { threshold: 0.15 });

	document.querySelectorAll('.reveal, .reveal-line').forEach((el) => observer.observe(el));
</script>
