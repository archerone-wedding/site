---
import PageLayout from '../layouts/PageLayout.astro';
import VenueMap from '../components/VenueMap.astro';
import { site } from '../data/site';
import {
	venue,
	venueAddress,
	venueDirectionsUrl,
	venueOsmUrl,
	church,
	churchAddress,
	churchDirectionsUrl,
	churchOsmUrl,
} from '../data/wedding';
---

<PageLayout
	title={`Accès — ${site.name}`}
	description={`Se rendre à ${churchAddress}`}
>
	<section class="page">
		<h1>Cérémonie</h1>
		<div class="section-separator"></div>

		<div class="church">
			<p class="church__name">{church.name}</p>
			<address class="church__address">{churchAddress}</address>

			<ul class="church__links">
				<li>
					<a href={churchDirectionsUrl} rel="noopener noreferrer" target="_blank">
						Ouvrir l'itinéraire
					</a>
				</li>
				<li>
					<a href={churchOsmUrl} rel="noopener noreferrer" target="_blank">
						Voir sur OpenStreetMap
					</a>
				</li>
			</ul>
		</div>

		<VenueMap lat={church.lat} lon={church.lon} zoom={church.zoom} label={churchAddress} />
	</section>
	<section class="page">
		<h1>Réception</h1>
		<div class="section-separator"></div>

		<div class="venue">
			<p class="venue__name">{venue.name}</p>
			<address class="venue__address">{venueAddress}</address>

			<ul class="venue__links">
				<li>
					<a href={venueDirectionsUrl} rel="noopener noreferrer" target="_blank">
						Ouvrir l'itinéraire
					</a>
				</li>
				<li>
					<a href={venueOsmUrl} rel="noopener noreferrer" target="_blank">
						Voir sur OpenStreetMap
					</a>
				</li>
			</ul>
		</div>

		<VenueMap lat={venue.lat} lon={venue.lon} zoom={venue.zoom} label={venueAddress} />
	</section>
</PageLayout>

<style>
	.page {
		max-width: 960px;
		margin: 0 auto;
		padding: 3rem 1.5rem 4rem;
	}

	h1 {
		margin: 0 0 0.75rem;
		font-family: var(--font-serif);
		font-style: italic;
		font-weight: 400;
		font-size: clamp(1.8rem, 4vw, 2.4rem);
		color: var(--color-navy-text);
		letter-spacing: 0.02em;
	}

	.section-separator {
		width: 180px;
		height: 1px;
		background: var(--color-navy-text);
		opacity: 0.35;
		margin: 0 0 2.5rem;
	}

	.venue {
		margin-bottom: 2rem;
	}

	.venue__name {
		margin: 0 0 0.25rem;
		font-weight: 600;
	}

	.venue__address {
		margin: 0 0 1.25rem;
		font-style: normal;
		color: var(--color-muted);
	}

	.venue__links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.venue__links a {
		color: var(--color-teal);
	}
	.church {
		margin-bottom: 2rem;
	}

	.church__name {
		margin: 0 0 0.25rem;
		font-weight: 600;
	}

	.church__address {
		margin: 0 0 1.25rem;
		font-style: normal;
		color: var(--color-muted);
	}

	.church__links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.church__links a {
		color: var(--color-teal);
	}
	@media (max-width: 720px) {
		.page {
			padding: 2rem 1.25rem 3rem;
		}
	}
</style>
