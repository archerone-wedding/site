---
import PageLayout from '../layouts/PageLayout.astro';
import { site } from '../data/site';
import ProgramA from '../components/program/ProgramA.astro';
import ProgramB from '../components/program/ProgramB.astro';
import ProgramC from '../components/program/ProgramC.astro';
import ProgramD from '../components/program/ProgramD.astro';

const group = Astro.locals.group;
const cat = group?.category || 'A';
---

<PageLayout title={`Le mariage — ${site.name}`}>
	<section class="page">
		<div class="page-bg" aria-hidden="true"></div>
		<div class="page-content">
			<div class="page-header">
				<h1 class="reveal">Le programme</h1>
				<div class="section-separator reveal-line"></div>
			</div>

			{cat === 'A' && <ProgramA />}
			{cat === 'B' && <ProgramB />}
			{cat === 'C' && <ProgramC />}
			{cat === 'D' && <ProgramD />}
		</div>
	</section>
</PageLayout>

<style>
	.page {
		position: relative;
		padding: 3rem 0 4rem;
	}

	.page-bg {
		position: absolute;
		inset: 0;
		background-image: url('/img/photo_mains.jpg');
		background-size: cover;
		background-position: center -260px;
		background-repeat: no-repeat;
		z-index: 0;
	}

	.page-bg::after {
		content: '';
		position: absolute;
		inset: 0;
		background: rgba(250, 249, 246, 0.82);
		z-index: 1;
	}

	.page-content {
		position: relative;
		z-index: 2;
		max-width: 960px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	h1 {
		margin: 0 0 1rem;
		font-family: var(--font-display);
		font-style: italic;
		font-weight: 500;
		font-size: clamp(2rem, 5vw, 2.8rem);
		color: var(--color-navy-text);
		letter-spacing: 0.02em;
	}

	.page-header {
		display: inline-block;
		vertical-align: top;
	}

	.page-header h1 {
		margin-bottom: 0.75rem;
	}

	.section-separator {
		width: 100%;
		height: 1px;
		background: var(--color-navy-text);
		opacity: 0.35;
		margin: 0 0 2.5rem;
	}

	/* Animations reveal */
	.reveal {
		opacity: 0;
		transform: translateY(25px);
		transition: opacity 700ms cubic-bezier(0.25, 0.46, 0.45, 0.94),
					transform 700ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
	}

	.reveal.is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	.section-separator.reveal-line {
		transform: scaleX(0);
		transform-origin: center;
		transition: transform 800ms cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.15s;
	}

	.section-separator.reveal-line.is-visible {
		transform: scaleX(1);
	}

	@media (max-width: 720px) {
		.page {
			padding: 2rem 0 3rem;
		}

		.page-content {
			padding: 0 1.25rem;
		}
	}
</style>

<script>
	const observer = new IntersectionObserver((entries) => {
		entries.forEach((entry) => {
			if (entry.isIntersecting) {
				entry.target.classList.add('is-visible');
				observer.unobserve(entry.target);
			}
		});
	}, { threshold: 0.15 });

	document.querySelectorAll('.reveal, .reveal-line').forEach((el) => observer.observe(el));
</script>
