---
import PageLayout from '../layouts/PageLayout.astro';
import { site } from '../data/site';
import ProgramA from '../components/program/ProgramA.astro';
import ProgramB from '../components/program/ProgramB.astro';
import ProgramC from '../components/program/ProgramC.astro';
import ProgramD from '../components/program/ProgramD.astro';

const group = Astro.locals.group;
const cat = group?.category || 'A';
---

<PageLayout title={`Le mariage — ${site.name}`}>
	<section class="page">
		<h1>Le programme</h1>
		<div class="section-separator"></div>

		{cat === 'A' && <ProgramA />}
		{cat === 'B' && <ProgramB />}
		{cat === 'C' && <ProgramC />}
		{cat === 'D' && <ProgramD />}
	</section>
</PageLayout>

<style>
	.page {
		max-width: 960px;
		margin: 0 auto;
		padding: 3rem 1.5rem 4rem;
	}

	h1 {
		margin: 0 0 1rem;
		font-family: var(--font-serif);
		font-style: italic;
		font-weight: 400;
		font-size: clamp(2rem, 5vw, 2.8rem);
		color: var(--color-navy-text);
		letter-spacing: 0.02em;
	}

	.section-separator {
		width: 180px;
		height: 1px;
		background: var(--color-navy-text);
		opacity: 0.35;
		margin: 0 0 2.5rem;
	}

	@media (max-width: 720px) {
		.page {
			padding: 2rem 1.25rem 3rem;
		}
	}
</style>
